# Copy to .env and change JWT_SECRET. Do not commit .env.

DATABASE_URL=postgresql+asyncpg://hilight:hilight@localhost:5432/hilight
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# tesseract (free, on the API machine) or fake (tests)
OCR_PROVIDER=tesseract
# whisper (local faster-whisper, optional extra) or fake
STT_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

OCR_MAX_BYTES=8388608
STT_MAX_BYTES=26214400
OCR_RATE_LIMIT=10
OCR_RATE_WINDOW_SECONDS=60
STT_RATE_LIMIT=6
STT_RATE_WINDOW_SECONDS=60

# fake costs nothing. llm calls DICTIONARY_BASE_URL with DICTIONARY_API_KEY.
# A cache hit is free. A miss is one short completion (gpt-4o-mini is typically under $0.001).
DICTIONARY_PROVIDER=fake
DICTIONARY_API_KEY=
DICTIONARY_BASE_URL=https://api.openai.com/v1
DICTIONARY_MODEL=gpt-4o-mini
DICTIONARY_RATE_LIMIT=30
DICTIONARY_RATE_WINDOW_SECONDS=60

# fake costs nothing. llm is one short chat completion per tutor action or rewrite
# (gpt-4o-mini is typically under $0.001). Chat and rewrite share AI_DAILY_LIMIT per UTC day.
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=20

# hash is free local overlap. openai is text-embedding-3-small at 384 dims
# (about $0.02 per 1M tokens; a sentence is a fraction of a cent).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
