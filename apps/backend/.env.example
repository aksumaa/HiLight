# Copy to .env and change JWT_SECRET. Do not commit .env.

DATABASE_URL=postgresql+asyncpg://hilight:hilight@localhost:5432/hilight
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# tesseract (free, on the API machine) or fake (tests)
OCR_PROVIDER=tesseract
# whisper (local faster-whisper, optional extra) or fake
STT_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

OCR_MAX_BYTES=8388608
STT_MAX_BYTES=26214400
OCR_RATE_LIMIT=10
OCR_RATE_WINDOW_SECONDS=60
STT_RATE_LIMIT=6
STT_RATE_WINDOW_SECONDS=60

# fake costs nothing. llm calls DICTIONARY_BASE_URL with DICTIONARY_API_KEY.
# A cache hit is free. A miss is one short completion (gpt-4o-mini is typically under $0.001).
DICTIONARY_PROVIDER=fake
DICTIONARY_API_KEY=
DICTIONARY_BASE_URL=https://api.openai.com/v1
DICTIONARY_MODEL=gpt-4o-mini
DICTIONARY_RATE_LIMIT=30
DICTIONARY_RATE_WINDOW_SECONDS=60
